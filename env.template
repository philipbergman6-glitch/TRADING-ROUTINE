# Alpaca — PAPER ONLY. scripts/alpaca.sh refuses any non-paper endpoint
# exactly matching the paper URL below. No live override is supported.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets/v2
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Account profile (docs/ACCOUNTS.md). Default production. The drill profile is
# the isolated engineering paper account used for recovery rehearsals; select
# it with ALPACA_PROFILE=drill or `alpaca.sh --account drill`. Its keys live in
# a SEPARATE file, .env.drill (gitignored), under these names — never in .env:
#   DRILL_ALPACA_API_KEY=...
#   DRILL_ALPACA_SECRET_KEY=...
# alpaca.sh and heartbeat.py refuse (exit 6) when both pairs are present in
# one process, and every write first checks the account_number pinned in
# scripts/accounts.json (exit 8 on mismatch). Create .env.drill with
# scripts/setup_drill_account.sh.
# ALPACA_PROFILE=production

# Perplexity (research)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar

# Resend (email notifications)
RESEND_API_KEY=enterithere
EMAIL_TO=philip.bergman6@gmail.com
EMAIL_FROM=onboarding@resend.dev

# Ledger (Postgres) — optional. Unset = ledger disabled (loud warning, orders
# still validate). Set = every verdict recorded; a failed write stops the order.
# Needs the extra: pip install -e ".[ledger]"
# Local: docker compose up -d
# DATABASE_URL=postgresql://trading:trading@localhost:5433/trading
DATABASE_URL=
